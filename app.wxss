/* 全局样式 —— 适老化基准：正文不小于 30rpx，主色高对比 */

page {
  background: #FFFFFF;
  color: #14261F;
  font-size: 30rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.6;}


view, text, button, input, textarea, picker {
  box-sizing: border-box;}


/* ---------- 布局 ---------- */
.page {
  min-height: 100vh;
  padding-bottom: 60rpx;}

.pad {
  padding: 0 30rpx;}

.section {
  margin-top: 40rpx;}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #14261F;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;}

.section-sub {
  font-size: 26rpx;
  color: #7A8B85;
  margin-top: -12rpx;
  margin-bottom: 24rpx;}


/* ---------- 卡片 ---------- */
.card {
  background: #FFFFFF;
  border: 2rpx solid #E6EFE9;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 60, 40, 0.06);
  margin-bottom: 24rpx;}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #14261F;}

.card-desc {
  font-size: 28rpx;
  color: #55665E;
  margin-top: 12rpx;}


/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  border: none;
  padding: 0 40rpx;}

.btn::after {
  border: none;}

.btn-primary {
  background: #15803D;
  color: #FFFFFF;}

.btn-primary:active {
  background: #0F5C2E;}

.btn-accent {
  background: linear-gradient(135deg, #22A855 0%, #15803D 100%);
  color: #FFFFFF;}

.btn-accent:active {
  background: #0F5C2E;}

.btn-ghost {
  background: #FFFFFF;
  color: #15803D;
  border: 2rpx solid #15803D;}

.btn-lg {
  height: 108rpx;
  font-size: 38rpx;}

.btn-block {
  width: 100%;}


/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #E9F6EE;
  color: #15803D;
  margin-right: 12rpx;
  margin-bottom: 8rpx;}

.tag-hot {
  background: #D9F1E2;
  color: #0B5F2C;}


/* ---------- 空状态 ---------- */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;}

.empty-icon {
  font-size: 96rpx;}

.empty-text {
  font-size: 30rpx;
  color: #7A8B85;
  margin-top: 24rpx;}


/* ---------- 表单 ---------- */
.form-item {
  margin-bottom: 36rpx;}

.form-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #14261F;
  margin-bottom: 16rpx;
  display: block;}

.form-label .required {
  color: #0F7A38;
  margin-left: 8rpx;}

.input {
  width: 100%;
  height: 100rpx;
  background: #F4F8F5;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  color: #14261F;}

.textarea {
  width: 100%;
  min-height: 160rpx;
  background: #F4F8F5;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #14261F;}

.picker-box {
  width: 100%;
  height: 100rpx;
  background: #F4F8F5;
  border-radius: 16rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;}

.picker-box.placeholder {
  color: #9AA8A2;}

.picker-arrow {
  color: #9AA8A2;
  font-size: 28rpx;}


/* ---------- 价格 ---------- */
.price {
  color: #0F7A38;
  font-weight: 700;}

.price-symbol {
  font-size: 26rpx;}

.price-num {
  font-size: 44rpx;}

.price-unit {
  font-size: 26rpx;
  font-weight: 400;
  color: #7A8B85;}

