/* ============================================================
   安心养老 · 设计系统
   参考稿：浅绿底 + 白卡片 + 中绿主色，圆角柔和、留白充足
   适老化：正文 ≥30rpx，点击区 ≥88rpx，文字对比度 ≥4.5:1
   ============================================================ */

page {
  background: #F4F8F2;
  color: #253528;
  font-size: 30rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.6;
}

view, text, button, input, textarea, picker, scroll-view {
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */
.page {
  min-height: 100vh;
  padding-bottom: 180rpx;
}

.pad {
  padding: 0 32rpx;
}

.section {
  margin-top: 36rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1F2D22;
  letter-spacing: 1rpx;
}

.section-sub {
  font-size: 26rpx;
  color: #5F7165;
}

/* ---------- 卡片 ---------- */
.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(58, 92, 64, 0.05);
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2D22;
}

.card-desc {
  font-size: 27rpx;
  color: #6B7B6E;
  margin-top: 10rpx;
  line-height: 1.6;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 999rpx;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
  padding: 0 40rpx;
  letter-spacing: 1rpx;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #3D9142 0%, #2E7D32 100%);
  color: #FFFFFF;
}

.btn-primary:active {
  background: #3D9142;
}

.btn-soft {
  background: #EAF6EB;
  color: #2E7D32;
}

.btn-ghost {
  background: #FFFFFF;
  color: #2E7D32;
  border: 2rpx solid #C8E6C9;
}

.btn-lg {
  height: 108rpx;
  font-size: 36rpx;
}

.btn-block {
  width: 100%;
}

.btn-sm {
  height: 76rpx;
  font-size: 28rpx;
  padding: 0 32rpx;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #EAF6EB;
  color: #2E7D32;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-warm {
  background: #FDEEE6;
  color: #B4552A;
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 110rpx 48rpx;
  text-align: center;
}

.empty-icon {
  font-size: 96rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #5F7165;
  margin-top: 24rpx;
  line-height: 1.7;
}

/* ---------- 表单 ---------- */
.form-item {
  margin-bottom: 36rpx;
}

.form-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2D22;
  margin-bottom: 16rpx;
}

.form-label .required {
  color: #D9534F;
  margin-left: 6rpx;
}

.input {
  width: 100%;
  height: 100rpx;
  background: #F6FAF5;
  border-radius: 18rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  color: #253528;
}

.textarea {
  width: 100%;
  min-height: 170rpx;
  background: #F6FAF5;
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #253528;
  line-height: 1.6;
}

.picker-box {
  width: 100%;
  height: 100rpx;
  background: #F6FAF5;
  border-radius: 18rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
}

.picker-box.placeholder {
  color: #5F7165;
}

.picker-arrow {
  color: #7A8C7E;
  font-size: 30rpx;
}

/* ---------- 列表行（我的页） ---------- */
.row-item {
  display: flex;
  align-items: center;
  height: 112rpx;
  border-bottom: 2rpx solid #F1F6F1;
}

.row-item:last-child {
  border-bottom: none;
}

.row-icon {
  width: 56rpx;
  font-size: 36rpx;
  margin-right: 20rpx;
  text-align: center;
}

.row-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.row-name {
  font-size: 32rpx;
  color: #1F2D22;
  font-weight: 500;
}

.row-desc {
  font-size: 24rpx;
  color: #5F7165;
  margin-top: 2rpx;
}

.row-arrow {
  font-size: 32rpx;
  color: #7A8C7E;
  margin-left: 12rpx;
}

/* ---------- 开关 ---------- */
.switch {
  width: 88rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #DCE7DD;
  padding: 5rpx;
  display: flex;
  align-items: center;
}

.switch.on {
  background: #4CAF50;
  justify-content: flex-end;
}

.switch-dot {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

/* ---------- 通用 ---------- */
.price {
  color: #C4512E;
  font-weight: 700;
}

.price-num {
  font-size: 40rpx;
}

.muted {
  color: #5F7165;
  font-size: 26rpx;
}

.divider {
  height: 2rpx;
  background: #F1F6F1;
  margin: 24rpx 0;
}
