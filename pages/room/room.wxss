/* 房间详情 */
.page {
  padding-bottom: 220rpx;
}

/* 实拍图区 */
.hero-wrap {
  padding: 24rpx 32rpx 8rpx;
}

.hero {
  height: 420rpx;
  border-radius: 28rpx;
  overflow: hidden;
  position: relative;
  background: #FFFFFF;
}

.hero.empty {
  border: 3rpx dashed #C8DCCC;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  text-align: center;
}

.cam {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #EAF6EB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 22rpx;
}

.t1 {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2D22;
}

.t2 {
  font-size: 25rpx;
  color: #5F7165;
  margin-top: 12rpx;
  line-height: 1.6;
}

.upload-btn {
  margin-top: 26rpx;
  height: 76rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  background: #EAF6EB;
  color: #2E7D32;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo {
  width: 100%;
  height: 100%;
  display: block;
}

.badge-change {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #2E7D32;
  font-size: 25rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.badge-del {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(31, 45, 34, 0.55);
  color: #FFFFFF;
  font-size: 25rpx;
  display: flex;
  align-items: center;
}

.badge-date {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(31, 45, 34, 0.62);
  color: #FFFFFF;
  font-size: 22rpx;
}

/* 隐患清单 */
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2D22;
}

.card-note {
  font-size: 23rpx;
  color: #5F7165;
}

.item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F6FAF5;
}

.item:last-child {
  border-bottom: none;
}

.dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #A5C9A8;
  margin-right: 20rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
  position: relative;
}

.dot.on {
  background: #2E7D32;
  border-color: #2E7D32;
}

.dot.on::after {
  content: "✓";
  position: absolute;
  left: 6rpx;
  top: -4rpx;
  color: #FFFFFF;
  font-size: 24rpx;
}

.item-text {
  flex: 1;
  font-size: 30rpx;
  color: #3D4A3F;
  line-height: 1.6;
}

.item-text.done {
  color: #5F7165;
  text-decoration: line-through;
}

/* 设计服务 */
.design {
  background: linear-gradient(135deg, #EDF7EE 0%, #DFF1E1 100%);
  border: 2rpx solid #C8E6C9;
}

.design-top {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.design-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 18rpx;
}

.design-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2D22;
}

.design-price {
  font-size: 21rpx;
  color: #B4552A;
  background: #FDEEE6;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin-left: 14rpx;
}

.design-desc {
  display: block;
  font-size: 26rpx;
  color: #3D4A3F;
  line-height: 1.65;
}

.design-points {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.dp {
  font-size: 22rpx;
  color: #2E7D32;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.design-btn {
  margin-top: 22rpx;
  height: 84rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #2E7D32;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.design-btn::after {
  border: none;
}

/* 提示 */
.tip {
  padding: 4rpx 8rpx 20rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #5F7165;
  line-height: 1.7;
}

/* 底部 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  box-shadow: 0 -4rpx 20rpx rgba(58, 92, 64, 0.07);
}

.foot-left {
  width: 240rpx;
  margin-right: 20rpx;
}

.foot-right {
  flex: 1;
}

/* ===== 超大字体（适老化）覆盖样式 ===== */
.bigfont .t1 {
  font-size: 40rpx;
  font-weight: 600;
  color: #1F2D22;
}

.bigfont .t2 {
  font-size: 31rpx;
  color: #5F7165;
  margin-top: 15rpx;
  line-height: 1.6;
}

.bigfont .card-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2D22;
}

.bigfont .card-note {
  font-size: 29rpx;
  color: #5F7165;
}

.bigfont .item-text {
  font-size: 37rpx;
  color: #3D4A3F;
  line-height: 1.6;
}

.bigfont .design-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2D22;
}

.bigfont .design-desc {
  font-size: 32rpx;
  color: #3D4A3F;
  line-height: 1.65;
}

.bigfont .tip-text {
  font-size: 30rpx;
  color: #5F7165;
  line-height: 1.7;
}
