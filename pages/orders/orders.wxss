page {
  background: #F4F8F2;
}

.page {
  padding-bottom: 60rpx;}

.pad {
  padding: 0 30rpx;}

.filter-bar {
  background: #FFFFFF;
  display: flex;
  padding: 16rpx 30rpx 20rpx;}

.filter-item {
  height: 80rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  background: #F6FAF5;}

.filter-item.active {
  background: #2E7D32;}

.filter-item text,
.filter-item {
  font-size: 28rpx;
  color: #6B7B6E;
  font-weight: 600;}

.filter-item.active {
  color: #FFFFFF;}

.order-card {
  border: 2rpx solid #EDF3ED;
  padding: 30rpx;}

.oc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 22rpx;
  border-bottom: 2rpx solid #EDF3ED;
  margin-bottom: 22rpx;}

.oc-head-left {
  display: flex;
  align-items: center;}

.oc-icon {
  font-size: 40rpx;
  margin-right: 16rpx;}

.oc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2D22;}

.oc-status {
  font-size: 25rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;}

.status-pending {
  background: #F6FAF5; color: #2E7D32;}

.status-accepted {
  background: #EAF6EB; color: #2E7D32;}

.status-serving {
  background: #DFF1E1; color: #2E7D32;}

/* 待评价：需要用户动手，用实心绿把它从灰色里拎出来 */
.status-rate {
  background: #2E7D32; color: #FFFFFF;}

.status-done {
  background: #EDF3ED; color: #6B7C74;}

.status-canceled {
  background: #F7FAF7; color: #6B7C74;}

.oc-row {
  display: flex;
  margin-bottom: 14rpx;}

.oc-label {
  font-size: 27rpx;
  color: #5F7165;
  width: 160rpx;
  flex-shrink: 0;}

.oc-value {
  flex: 1;
  font-size: 28rpx;
  color: #3D4A3F;}

.oc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #EDF3ED;}

.oc-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #C4512E;}

.oc-actions {
  display: flex;}

.btn-sm {
  height: 76rpx;
  font-size: 26rpx;
  border-radius: 16rpx;
  padding: 0 28rpx;
  margin: 0 0 0 18rpx;
  font-weight: 700;}

.btn-ghost {
  background: #FFFFFF;
  color: #2E7D32;
  border: 2rpx solid #2E7D32;}

.btn-primary {
  background: #2E7D32;
  color: #FFFFFF;}

.btn-sm::after {
  border: none;}

.btn-block {
  width: 100%;}

.btn {
  display: flex; align-items: center; justify-content: center; border-radius: 20rpx;}

.btn::after {
  border: none;}

.empty {
  padding: 130rpx 40rpx; text-align: center;}

.empty-icon {
  font-size: 100rpx;}

.empty-text {
  display: block; font-size: 30rpx; color: #5F7165; margin: 24rpx 0 40rpx;}

.empty-btn {
  width: 420rpx;
  background: #2E7D32;
  color: #FFFFFF;
  font-size: 32rpx;
  height: 96rpx;}


