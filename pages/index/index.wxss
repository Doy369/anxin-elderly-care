page {
  background: #FFFFFF;}

.page {
  padding-bottom: 60rpx;}

.pad {
  padding: 0 30rpx;}


/* ---------- 顶部 ---------- */
.header {
  position: relative;
  margin-bottom: 30rpx;}

.header-bg {
  height: 340rpx;
  background: linear-gradient(160deg, #15803D 0%, #22A855 100%);
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;}

.header-inner {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 40rpx 30rpx 0;}

.greet-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;}

.greet-left {
  display: flex;
  flex-direction: column;}

.greet-text {
  font-size: 42rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;}

.greet-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-top: 10rpx;}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;}

.quick-call {
  margin-top: 36rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 6rpx 24rpx rgba(21, 128, 61, 0.14);}

.qc-icon {
  font-size: 52rpx;
  margin-right: 24rpx;}

.qc-body {
  flex: 1;
  display: flex;
  flex-direction: column;}

.qc-title {
  font-size: 26rpx;
  color: #7A8B85;}

.qc-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #14261F;
  letter-spacing: 1rpx;
  margin-top: 4rpx;}

.qc-arrow {
  font-size: 44rpx;
  color: #9AA8A2;}


/* ---------- 模式切换 ---------- */
.mode-switch {
  border: 2rpx solid #E6EFE9;
  margin-top: 30rpx;
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 12rpx;
  box-shadow: 0 4rpx 18rpx rgba(20, 60, 40, 0.06);}

.mode-item {
  flex: 1;
  height: 96rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;}

.mode-item.active {
  background: #15803D;}

.mode-icon {
  font-size: 32rpx;
  margin-right: 12rpx;}

.mode-text {
  font-size: 30rpx;
  color: #55665E;
  font-weight: 600;}

.mode-item.active .mode-text {
  color: #FFFFFF;}


/* ---------- 快捷入口 ---------- */
.section {
  margin-top: 44rpx;}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #14261F;
  margin-bottom: 8rpx;}

.section-sub {
  font-size: 26rpx;
  color: #7A8B85;
  margin-bottom: 24rpx;}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;}

.quick-card {
  border: 2rpx solid #E6EFE9;
  width: 48.5%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(20, 60, 40, 0.05);
  display: flex;
  flex-direction: column;}

.qc-emoji {
  font-size: 56rpx;}

.qc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #14261F;
  margin-top: 18rpx;}

.qc-desc {
  font-size: 26rpx;
  color: #7A8B85;
  margin-top: 8rpx;}


/* ---------- 订单卡片 ---------- */
.order-card {
  padding: 28rpx;}

.order-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;}

.order-icon {
  font-size: 44rpx;
  margin-right: 20rpx;}

.order-head-body {
  flex: 1;
  display: flex;
  flex-direction: column;}

.order-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #14261F;}

.order-no {
  font-size: 24rpx;
  color: #9AA8A2;
  margin-top: 4rpx;}

.order-status {
  font-size: 26rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;}

.status-pending {
  background: #F1F6F2;
  color: #0B5F2C;}

.status-accepted {
  background: #E9F6EE;
  color: #15803D;}

.status-serving {
  background: #D3EFE0;
  color: #0B5F2C;}

.order-line {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;}

.order-line-label {
  font-size: 26rpx;
  color: #9AA8A2;
  width: 150rpx;
  flex-shrink: 0;}

.order-line-value {
  font-size: 28rpx;
  color: #3D4F49;
  flex: 1;}

.order-actions {
  display: flex;
  margin-top: 20rpx;}

.btn-sm {
  height: 80rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
  padding: 0 28rpx;
  margin-right: 20rpx;}

.btn-ghost {
  background: #FFFFFF;
  color: #15803D;
  border: 2rpx solid #15803D;}

.btn-primary {
  background: #15803D;
  color: #FFFFFF;}

.btn-block {
  width: 100%;}


/* ---------- 服务卡片 ---------- */
.svc-card {
  padding: 30rpx;}

.svc-top {
  display: flex;
  align-items: flex-start;}

.svc-icon {
  font-size: 48rpx;
  margin-right: 20rpx;}

.svc-body {
  flex: 1;
  display: flex;
  flex-direction: column;}

.svc-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #14261F;}

.svc-meta {
  display: flex;
  margin-top: 10rpx;}

.svc-meta-item {
  font-size: 25rpx;
  color: #7A8B85;
  margin-right: 24rpx;}

.svc-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;}

.price {
  color: #0F7A38;
  font-weight: 700;
  display: flex;
  align-items: baseline;}

.price-symbol {
  font-size: 26rpx;}

.price-num {
  font-size: 44rpx;}

.price-unit {
  font-size: 24rpx;
  color: #7A8B85;
  margin-top: 2rpx;}

.svc-desc {
  font-size: 28rpx;
  color: #55665E;
  margin-top: 18rpx;
  line-height: 1.65;}

.tag-row {
  margin-top: 18rpx;}

.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #E9F6EE;
  color: #15803D;
  margin-right: 12rpx;
  margin-bottom: 8rpx;}

.tag-hot {
  background: #D9F1E2;
  color: #0B5F2C;}


/* ---------- 保障 ---------- */
.guarantee {
  border: 2rpx solid #E6EFE9;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  margin-top: 44rpx;}

.guarantee-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 30%;}

.g-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;}

.g-text {
  font-size: 24rpx;
  color: #55665E;
  text-align: center;}


