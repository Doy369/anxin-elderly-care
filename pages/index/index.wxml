<view class="page {{bigFont ? 'bigfont' : ''}}">

  <!-- 顶部问候 -->
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-inner">
      <view class="greet-row">
        <view class="greet-left">
          <text class="greet-text">{{greeting}}，{{nickname}}</text>
          <text class="greet-sub">{{modeText}}</text>
        </view>
        <view class="avatar" bindtap="goProfile">{{avatarText}}</view>
      </view>

      <view class="quick-call" bindtap="callService">
        <text class="qc-icon">📞</text>
        <view class="qc-body">
          <text class="qc-title">需要帮助？打电话</text>
          <text class="qc-num">400-800-1234</text>
        </view>
        <text class="qc-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="pad">
    <!-- 模式切换 -->
    <view class="mode-switch">
      <view class="mode-item {{mode === 'elder' ? 'active' : ''}}" data-mode="elder" bindtap="switchMode">
        <text class="mode-icon">👴</text>
        <text class="mode-text">我自己用</text>
      </view>
      <view class="mode-item {{mode === 'family' ? 'active' : ''}}" data-mode="family" bindtap="switchMode">
        <text class="mode-icon">👨‍👩‍👧</text>
        <text class="mode-text">帮家人下单</text>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="section">
      <view class="section-title">常用服务</view>
      <view class="quick-grid">
        <view class="quick-card" wx:for="{{quickEntries}}" wx:key="key" data-cat="{{item.cat}}" bindtap="goCategory">
          <text class="qc-emoji">{{item.icon}}</text>
          <text class="qc-name">{{item.name}}</text>
          <text class="qc-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <!-- 进行中的订单 -->
    <view class="section" wx:if="{{activeOrders.length > 0}}">
      <view class="section-title">
        <text>进行中的服务</text>
      </view>
      <view class="card order-card" wx:for="{{activeOrders}}" wx:key="id" data-id="{{item.id}}" bindtap="goOrderDetail">
        <view class="order-head">
          <text class="order-icon">{{item.icon}}</text>
          <view class="order-head-body">
            <text class="order-name">{{item.serviceName}}</text>
            <text class="order-no">单号 {{item.id}}</text>
          </view>
          <text class="order-status status-{{item.statusKey}}">{{item.status}}</text>
        </view>
        <view class="order-line">
          <text class="order-line-label">上门时间</text>
          <text class="order-line-value">{{item.date}} {{item.timeSlot}}</text>
        </view>
        <view class="order-line" wx:if="{{item.forWhom}}">
          <text class="order-line-label">服务对象</text>
          <text class="order-line-value">{{item.forWhom}}</text>
        </view>
        <view class="order-actions">
          <button class="btn btn-ghost btn-sm" catchtap="contactWorker" data-id="{{item.id}}">联系服务人员</button>
          <button class="btn btn-primary btn-sm" catchtap="goOrderDetail" data-id="{{item.id}}">查看详情</button>
        </view>
      </view>
    </view>

    <!-- 适老化改造推荐 -->
    <view class="section">
      <view class="section-title">适老化家居安装</view>
      <view class="section-sub">政府补贴可申请 · 上门测量 · 师傅安装</view>
      <view class="card svc-card" wx:for="{{installList}}" wx:key="id" data-id="{{item.id}}" bindtap="goService">
        <view class="svc-top">
          <text class="svc-icon">{{item.icon}}</text>
          <view class="svc-body">
            <text class="svc-name">{{item.name}}</text>
            <view class="svc-meta">
              <text class="svc-meta-item">⭐ {{item.rating}}</text>
              <text class="svc-meta-item">已服务 {{item.orderCountText}} 单</text>
            </view>
          </view>
          <view class="svc-price">
            <text class="price"><text class="price-symbol">¥</text><text class="price-num">{{item.price}}</text></text>
            <text class="price-unit">{{item.priceUnit}}{{item.unit}}</text>
          </view>
        </view>
        <view class="svc-desc">{{item.desc}}</view>
        <view class="tag-row">
          <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
        </view>
      </view>
      <button class="btn btn-ghost btn-block" bindtap="goInstallAll">查看全部改造项目</button>
    </view>

    <!-- 养老服务推荐 -->
    <view class="section">
      <view class="section-title">居家养老服务</view>
      <view class="section-sub">持证上门 · 服务留痕 · 子女可查</view>
      <view class="card svc-card" wx:for="{{careList}}" wx:key="id" data-id="{{item.id}}" bindtap="goService">
        <view class="svc-top">
          <text class="svc-icon">{{item.icon}}</text>
          <view class="svc-body">
            <text class="svc-name">{{item.name}}</text>
            <view class="svc-meta">
              <text class="svc-meta-item">⭐ {{item.rating}}</text>
              <text class="svc-meta-item">{{item.duration}}</text>
            </view>
          </view>
          <view class="svc-price">
            <text class="price"><text class="price-symbol">¥</text><text class="price-num">{{item.price}}</text></text>
            <text class="price-unit">{{item.priceUnit}}{{item.unit}}</text>
          </view>
        </view>
        <view class="svc-desc">{{item.desc}}</view>
        <view class="tag-row">
          <text class="tag tag-hot" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
        </view>
      </view>
      <button class="btn btn-ghost btn-block" bindtap="goCareAll">查看全部养老服务</button>
    </view>

    <!-- 安心保障 -->
    <view class="section guarantee">
      <view class="guarantee-item">
        <text class="g-icon">✅</text>
        <text class="g-text">服务人员实名认证</text>
      </view>
      <view class="guarantee-item">
        <text class="g-icon">🔒</text>
        <text class="g-text">过程全程留痕</text>
      </view>
      <view class="guarantee-item">
        <text class="g-icon">↩️</text>
        <text class="g-text">不满意 24 小时内可退</text>
      </view>
    </view>
  </view>

</view>
