/* 我的家 */
.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-top: 28rpx;
  padding-bottom: 32rpx;
}

.head-left {
  display: flex;
  flex-direction: column;
}

.head-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #1F2D22;
  letter-spacing: 2rpx;
}

.head-sub {
  font-size: 26rpx;
  color: #5F7165;
  margin-top: 12rpx;
}

.head-tip {
  font-size: 22rpx;
  color: #5F7165;
  text-align: right;
  line-height: 1.5;
  white-space: pre-line;
  flex-shrink: 0;
  margin-left: 20rpx;
}

/* 房间宫格 */
.room-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.room-card {
  width: 48.6%;
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(58, 92, 64, 0.05);
}

.room-photo {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.room-img {
  width: 100%;
  height: 100%;
  display: block;
}

.room-emoji {
  font-size: 92rpx;
}

.room-badge {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #74876F;
  font-size: 20rpx;
}

.room-info {
  padding: 20rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.room-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2D22;
}

.room-desc {
  font-size: 24rpx;
  color: #5F7165;
  margin-top: 6rpx;
}

/* 提示卡 */
.tip-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-top: 8rpx;
  box-shadow: 0 6rpx 20rpx rgba(58, 92, 64, 0.05);
}

.tip-icon {
  font-size: 42rpx;
  margin-right: 20rpx;
}

.tip-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tip-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #1F2D22;
}

.tip-desc {
  font-size: 24rpx;
  color: #5F7165;
  margin-top: 6rpx;
  line-height: 1.5;
}

/* ===== 超大字体（适老化）覆盖样式 ===== */
.bigfont .head-title {
  font-size: 64rpx;
  font-weight: 700;
  color: #1F2D22;
  letter-spacing: 2rpx;
}

.bigfont .head-sub {
  font-size: 32rpx;
  color: #5F7165;
  margin-top: 14rpx;
}

.bigfont .head-tip {
  font-size: 27rpx;
  color: #5F7165;
  text-align: right;
  line-height: 1.5;
}

.bigfont .room-info {
  padding: 23rpx 27rpx 27rpx;
  display: flex;
  flex-direction: column;
}

.bigfont .room-name {
  font-size: 39rpx;
  font-weight: 700;
  color: #1F2D22;
}

.bigfont .room-desc {
  font-size: 29rpx;
  color: #5F7165;
  margin-top: 7rpx;
}

.bigfont .tip-title {
  font-size: 35rpx;
  font-weight: 600;
  color: #1F2D22;
}

.bigfont .tip-desc {
  font-size: 29rpx;
  color: #5F7165;
  margin-top: 7rpx;
  line-height: 1.5;
}

/* ---------- 当前房屋 ---------- */
.home-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(58, 92, 64, 0.05);
}

.home-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #EAF6EB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.home-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.home-name-row {
  display: flex;
  align-items: center;
}

.home-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2D22;
  max-width: 340rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.home-switch {
  font-size: 22rpx;
  color: #2E7D32;
  background: #EAF6EB;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
}

.home-addr {
  font-size: 24rpx;
  color: #5F7165;
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 房间角标 */
.room-checked {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(46, 125, 50, 0.9);
  color: #FFFFFF;
  font-size: 20rpx;
}

/* ---------- 弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(31, 45, 34, 0.42);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 86vh;
  overflow: hidden;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.sheet-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1F2D22;
}

.sheet-close {
  font-size: 32rpx;
  color: #7A8C7E;
  padding: 0 12rpx;
}

/* 房屋列表项 */
.home-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-radius: 20rpx;
  background: #F6FAF5;
  margin-bottom: 16rpx;
}

.hi-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.hi-name-row {
  display: flex;
  align-items: center;
}

.hi-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2D22;
}

.hi-current {
  font-size: 20rpx;
  color: #2E7D32;
  background: #DFF1E1;
  border-radius: 999rpx;
  padding: 3rpx 14rpx;
  margin-left: 12rpx;
}

.hi-addr {
  font-size: 23rpx;
  color: #5F7165;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hi-edit,
.hi-del {
  font-size: 25rpx;
  padding: 8rpx 14rpx;
  flex-shrink: 0;
}

.hi-edit {
  color: #2E7D32;
}

.hi-del {
  color: #74876F;
}

.add-home-btn {
  margin-top: 8rpx;
  flex-shrink: 0;
}

/* 表单 */
.form-body {
  flex: 1;
  min-height: 0;
}

.form-row {
  display: flex;
  justify-content: space-between;
}

.form-item.half {
  width: 48%;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  background: #F6FAF5;
  border-radius: 18rpx;
  padding: 0 28rpx;
}

.switch-text {
  font-size: 30rpx;
  color: #3D4A3F;
}

.sheet-foot {
  flex-shrink: 0;
  padding-top: 20rpx;
}

.save-btn {
  height: 96rpx;
  font-size: 32rpx;
}

/* ===== 超大字体（适老化）覆盖样式 ===== */
.bigfont .home-name {
  font-size: 39rpx;
  font-weight: 700;
  color: #1F2D22;
}

.bigfont .home-addr {
  font-size: 29rpx;
  color: #5F7165;
  margin-top: 9rpx;
}

.bigfont .sheet-title {
  font-size: 47rpx;
  font-weight: 700;
  color: #1F2D22;
}

.bigfont .hi-name {
  font-size: 37rpx;
  font-weight: 600;
  color: #1F2D22;
}

.bigfont .hi-addr {
  font-size: 28rpx;
  color: #5F7165;
  margin-top: 7rpx;
}
