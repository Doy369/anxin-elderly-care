page {
  background: #FFFFFF;}

.page {
  padding-bottom: 60rpx;}

.pad {
  padding: 0 30rpx;}

.page-head {
  padding: 32rpx 30rpx 8rpx;}

.ph-title {
  font-size: 40rpx; font-weight: 700; color: #14261F; display: block;}

.ph-sub {
  font-size: 26rpx; color: #7A8B85; margin-top: 12rpx; display: block; line-height: 1.6;}

.card {
  border: 2rpx solid #E6EFE9;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-top: 24rpx;}

.card-title {
  font-size: 34rpx; font-weight: 700; color: #14261F; margin-bottom: 24rpx;}

.member-card {
  display: flex; align-items: flex-start;}

.mc-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #E9F6EE;
  color: #15803D;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;}

.mc-body {
  flex: 1; display: flex; flex-direction: column;}

.mc-name-row {
  display: flex; align-items: center; flex-wrap: wrap;}

.mc-name {
  font-size: 34rpx; font-weight: 700; color: #14261F; margin-right: 16rpx;}

.mc-relation {
  font-size: 23rpx;
  background: #E9F6EE;
  color: #15803D;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;}

.mc-age {
  font-size: 25rpx; color: #7A8B85;}

.mc-phone, .mc-addr, .mc-note, .mc-count {
  font-size: 26rpx;
  color: #55665E;
  margin-top: 10rpx;}

.mc-note {
  color: #7A8B85; line-height: 1.6;}

.mc-count {
  color: #15803D;}

.mc-actions {
  display: flex; margin-top: 20rpx; flex-wrap: wrap;}

.chip-btn {
  height: 68rpx;
  line-height: 68rpx;
  font-size: 25rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #15803D;
  color: #FFFFFF;
  margin: 0 16rpx 0 0;
  border: none;
  font-weight: 600;}

.chip-btn::after {
  border: none;}

.chip-btn.ghost {
  background: #FFFFFF; color: #15803D; border: 2rpx solid #15803D;}

.chip-btn.danger {
  background: #FFFFFF; color: #5F7168; border: 2rpx solid #E4EAE6;}

.add-btn {
  margin-top: 36rpx; height: 104rpx; font-size: 34rpx;}

.btn {
  display: flex; align-items: center; justify-content: center; border-radius: 20rpx; font-weight: 700;}

.btn::after {
  border: none;}

.btn-block {
  width: 100%;}

.btn-primary {
  background: #15803D; color: #FFFFFF;}


/* 弹层 */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(20, 60, 40, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;}

.sheet {
  width: 100%;
  border: 2rpx solid #E6EFE9;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 88vh;
  display: flex;
  flex-direction: column;}

.sheet-head {
  background: #FFFFFF;
  padding: 32rpx 30rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #E6EFE9;}

.sheet-title {
  font-size: 34rpx; font-weight: 700; color: #14261F;}

.sheet-close {
  font-size: 32rpx; color: #9AA8A2; padding: 0 10rpx;}

.sheet-body {
  padding: 30rpx 30rpx 60rpx;}

.form-item {
  margin-bottom: 34rpx;}

.form-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #14261F;
  margin-bottom: 16rpx;
  display: block;}

.required {
  color: #0F7A38; margin-left: 8rpx;}

.input {
  width: 100%;
  height: 100rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  color: #14261F;}

.textarea {
  width: 100%;
  min-height: 170rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #14261F;}

.rel-row {
  display: flex; flex-wrap: wrap;}

.rel-item {
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid transparent;}

.rel-item.active {
  background: #E9F6EE; border-color: #15803D;}

.rel-text {
  font-size: 28rpx; color: #3D4F49;}

.rel-item.active .rel-text {
  color: #15803D; font-weight: 700;}

.save-btn {
  height: 104rpx; font-size: 34rpx; margin-top: 10rpx;}

.empty {
  padding: 120rpx 40rpx; text-align: center;}

.empty-icon {
  font-size: 96rpx;}

.empty-text {
  display: block; font-size: 30rpx; color: #7A8B85; margin-top: 24rpx; line-height: 1.6;}


