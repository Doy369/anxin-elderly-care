/* 帮我一下 */
.head {
  padding-top: 32rpx;
  padding-bottom: 36rpx;
  display: flex;
  flex-direction: column;
}

.head-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1F2D22;
  letter-spacing: 1rpx;
}

.head-sub {
  font-size: 27rpx;
  color: #5F7165;
  margin-top: 12rpx;
}

/* 服务宫格 */
.help-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.help-card {
  width: 48.6%;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 26rpx 30rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(58, 92, 64, 0.05);
  display: flex;
  flex-direction: column;
}

.help-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.help-emoji {
  font-size: 52rpx;
}

.help-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2D22;
}

.help-desc {
  font-size: 23rpx;
  color: #5F7165;
  margin-top: 8rpx;
}

/* 绿色行动卡 */
.cta {
  margin-top: 10rpx;
  background: linear-gradient(135deg, #3D9142 0%, #2E7D32 100%);
  border-radius: 32rpx;
  padding: 34rpx 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 28rpx rgba(67, 160, 71, 0.24);
}

.cta-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.cta-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.cta-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
}

.cta-btn {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #FFFFFF;
  font-size: 25rpx;
  margin-top: 20rpx;
}

.cta-emoji {
  font-size: 96rpx;
  margin-left: 12rpx;
  opacity: 0.92;
}

/* ===== 超大字体（适老化）覆盖样式 ===== */
.bigfont .head-title {
  font-size: 60rpx;
  font-weight: 700;
  color: #1F2D22;
  letter-spacing: 1rpx;
}

.bigfont .head-sub {
  font-size: 33rpx;
  color: #5F7165;
  margin-top: 14rpx;
}

.bigfont .help-card {
  padding: 32rpx 30rpx 34rpx;
  display: flex;
  flex-direction: column;
}

.bigfont .help-name {
  font-size: 39rpx;
  font-weight: 700;
  color: #1F2D22;
}

.bigfont .help-desc {
  font-size: 28rpx;
  color: #5F7165;
  margin-top: 9rpx;
}

.bigfont .cta-title {
  font-size: 39rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.bigfont .cta-sub {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 9rpx;
}

.bigfont .cta-btn {
  height: 73rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  margin-top: 23rpx;
}
