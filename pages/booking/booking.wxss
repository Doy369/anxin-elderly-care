/* 预约（三步） */
.page {
  padding-bottom: 220rpx;
}

/* 步骤条 */
.stepper {
  display: flex;
  align-items: flex-start;
  padding-top: 28rpx;
  padding-bottom: 32rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  flex-shrink: 0;
}

.dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #E8F0E9;
  color: #5F7165;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dot.on {
  background: #4CAF50;
  color: #FFFFFF;
}

.step-label {
  font-size: 23rpx;
  color: #5F7165;
  margin-top: 12rpx;
  text-align: center;
}

.step-label.on {
  color: #2E7D32;
  font-weight: 600;
}

.line {
  flex: 1;
  height: 3rpx;
  background: #E8F0E9;
  margin-top: 23rpx;
}

.line.on {
  background: #A5D6A7;
}

/* 区块 */
.block {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(58, 92, 64, 0.05);
}

.block-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2D22;
  margin-bottom: 22rpx;
}

.block-title.plain {
  margin-bottom: 0;
}

.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.counter {
  font-size: 23rpx;
  color: #5F7165;
}

/* 选择行 */
.pick-row {
  display: flex;
  align-items: center;
  height: 100rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #F6FAF5;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.pick-row:last-child {
  margin-bottom: 0;
}

.pick-row.on {
  background: #EDF7EE;
  border-color: #66BB6A;
}

.pick-icon {
  font-size: 36rpx;
  margin-right: 18rpx;
}

.pick-text {
  flex: 1;
  font-size: 31rpx;
  color: #253528;
}

.pick-row.on .pick-text {
  color: #2E7D32;
  font-weight: 600;
}

.pick-check {
  font-size: 30rpx;
  color: #2E7D32;
  font-weight: 700;
}

/* 字段行 */
.field {
  display: flex;
  align-items: center;
  height: 104rpx;
  border-bottom: 2rpx solid #F1F6F1;
}

.field:last-child {
  border-bottom: none;
}

.field-icon {
  font-size: 34rpx;
  margin-right: 18rpx;
}

.field-label {
  font-size: 29rpx;
  color: #6B7B6E;
  margin-right: 20rpx;
}

.field-value {
  flex: 1;
  font-size: 31rpx;
  color: #1F2D22;
  text-align: right;
}

.field-value.ph {
  color: #74876F;
}

.field-arrow {
  font-size: 30rpx;
  color: #7A8C7E;
  margin-left: 10rpx;
}

/* 陪诊人卡片 */
.comp-row {
  display: flex;
  justify-content: space-between;
}

.comp-card {
  width: 48.5%;
  background: #F6FAF5;
  border: 2rpx solid transparent;
  border-radius: 22rpx;
  padding: 24rpx 22rpx;
  display: flex;
  flex-direction: column;
}

.comp-card.on {
  background: #EDF7EE;
  border-color: #66BB6A;
}

.comp-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.comp-emoji {
  font-size: 52rpx;
}

.comp-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #2E7D32;
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.comp-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #1F2D22;
}

.comp-desc {
  font-size: 22rpx;
  color: #5F7165;
  margin-top: 6rpx;
}

/* 表单 */
.input {
  margin-bottom: 18rpx;
}

.input:last-child {
  margin-bottom: 0;
}

.ph-text {
  color: #74876F;
  font-size: 28rpx;
}

/* 确认页 */
.sum-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F6FAF5;
}

.sum-row:last-child {
  border-bottom: none;
}

.sum-label {
  width: 190rpx;
  font-size: 27rpx;
  color: #5F7165;
  flex-shrink: 0;
}

.sum-value {
  flex: 1;
  font-size: 29rpx;
  color: #1F2D22;
  line-height: 1.6;
}

.notice {
  background: #EDF7EE;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
}

.notice-text {
  font-size: 25rpx;
  color: #4E7A54;
  line-height: 1.6;
}

/* 底部 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  box-shadow: 0 -4rpx 20rpx rgba(58, 92, 64, 0.07);
}

.footer-back {
  width: 200rpx;
  margin-right: 20rpx;
}

.footer-next {
  flex: 1;
}

/* ===== 超大字体（适老化）覆盖样式 ===== */
.bigfont .step-label {
  font-size: 28rpx;
  color: #5F7165;
  margin-top: 14rpx;
  text-align: center;
}

.bigfont .block-title {
  font-size: 37rpx;
  font-weight: 700;
  color: #1F2D22;
  margin-bottom: 25rpx;
}

.bigfont .pick-text {
  font-size: 38rpx;
  color: #253528;
}

.bigfont .field-label {
  font-size: 36rpx;
  color: #6B7B6E;
  margin-right: 23rpx;
}

.bigfont .field-value {
  font-size: 38rpx;
  color: #1F2D22;
  text-align: right;
}

.bigfont .comp-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2D22;
}

.bigfont .comp-desc {
  font-size: 27rpx;
  color: #5F7165;
  margin-top: 7rpx;
}

.bigfont .sum-label {
  font-size: 33rpx;
  color: #5F7165;
}

.bigfont .sum-value {
  font-size: 35rpx;
  color: #1F2D22;
  line-height: 1.6;
}

.bigfont .notice-text {
  font-size: 30rpx;
  color: #4E7A54;
  line-height: 1.6;
}

/* 房间上下文提示 */
.room-tip {
  display: flex;
  align-items: center;
  background: #EDF7EE;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 22rpx;
}

.room-tip-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}

.room-tip-text {
  font-size: 27rpx;
  color: #2E7D32;
  font-weight: 600;
}
