<view class="page {{bigFont ? 'bigfont' : ''}}">

  <!-- 步骤条 -->
  <view class="stepper pad">
    <block wx:for="{{steps}}" wx:key="index">
      <view class="step">
        <view class="dot {{step >= index + 1 ? 'on' : ''}}">{{index + 1}}</view>
        <text class="step-label {{step >= index + 1 ? 'on' : ''}}">{{item}}</text>
      </view>
      <view class="line {{step > index + 1 ? 'on' : ''}}" wx:if="{{index < 2}}"></view>
    </block>
  </view>

  <view class="pad">

    <view class="room-tip" wx:if="{{roomName}}">
      <text class="room-tip-icon">🏠</text>
      <text class="room-tip-text">本次改造房间：{{roomName}}</text>
    </view>

    <!-- 第 1 步：选择项目 -->
    <block wx:if="{{step === 1}}">
      <view class="block">
        <text class="block-title">{{service.primaryLabel}}</text>
        <view
          class="pick-row {{form.primaryIndex === index ? 'on' : ''}}"
          wx:for="{{service.primaryOptions}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="pickPrimary"
        >
          <text class="pick-icon">{{service.icon}}</text>
          <text class="pick-text">{{item}}</text>
          <text class="pick-check" wx:if="{{form.primaryIndex === index}}">✓</text>
        </view>
      </view>
    </block>

    <!-- 第 2 步：预约信息 -->
    <block wx:if="{{step === 2}}">
      <view class="block">
        <text class="block-title">上门 / 服务时间</text>

        <picker mode="date" value="{{form.date}}" start="{{today}}" bindchange="onDate">
          <view class="field">
            <text class="field-icon">📅</text>
            <text class="field-label">{{dateLabel}}</text>
            <text class="field-value {{form.date ? '' : 'ph'}}">{{form.date || '请选择日期'}}</text>
            <text class="field-arrow">›</text>
          </view>
        </picker>

        <picker mode="time" value="{{form.time}}" bindchange="onTime">
          <view class="field">
            <text class="field-icon">🕘</text>
            <text class="field-label">服务时间</text>
            <text class="field-value {{form.time ? '' : 'ph'}}">{{timeText || '请选择时间'}}</text>
            <text class="field-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="block" wx:if="{{service.companion}}">
        <text class="block-title">选择陪诊人</text>
        <view class="comp-row">
          <view
            class="comp-card {{form.companion === item.id ? 'on' : ''}}"
            wx:for="{{companions}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="pickCompanion"
          >
            <view class="comp-top">
              <text class="comp-emoji">{{item.id === 'pro' ? '👩‍⚕️' : '👨‍👩‍👧'}}</text>
              <text class="comp-check" wx:if="{{form.companion === item.id}}">✓</text>
            </view>
            <text class="comp-name">{{item.name}}</text>
            <text class="comp-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <view class="block">
        <text class="block-title">联系信息</text>
        <input class="input mb" placeholder="联系人姓名" value="{{form.contactName}}" data-field="contactName" bindinput="onInput" />
        <input class="input mb" type="number" maxlength="11" placeholder="手机号" value="{{form.phone}}" data-field="phone" bindinput="onInput" />
        <input class="input" placeholder="服务地址（详细到门牌号）" value="{{form.address}}" data-field="address" bindinput="onInput" />
      </view>

      <view class="block">
        <view class="block-head">
          <text class="block-title plain">备注（选填）</text>
          <text class="counter">{{remarkLen}}/20</text>
        </view>
        <textarea
          class="textarea"
          maxlength="20"
          placeholder="如：就诊科室、特殊需求等"
          placeholder-class="ph-text"
          value="{{form.remark}}"
          data-field="remark"
          bindinput="onInput"
        />
      </view>
    </block>

    <!-- 第 3 步：确认提交 -->
    <block wx:if="{{step === 3}}">
      <view class="block">
        <text class="block-title">确认预约信息</text>

        <view class="sum-row">
          <text class="sum-label">服务项目</text>
          <text class="sum-value">{{service.name}}</text>
        </view>
        <view class="sum-row" wx:if="{{roomName}}">
          <text class="sum-label">改造房间</text>
          <text class="sum-value">{{roomName}}</text>
        </view>
        <view class="sum-row">
          <text class="sum-label">{{service.primaryLabel}}</text>
          <text class="sum-value">{{form.primary || '未选择'}}</text>
        </view>
        <view class="sum-row">
          <text class="sum-label">{{dateLabel}}</text>
          <text class="sum-value">{{form.date}}</text>
        </view>
        <view class="sum-row">
          <text class="sum-label">服务时间</text>
          <text class="sum-value">{{timeText}}</text>
        </view>
        <view class="sum-row" wx:if="{{service.companion}}">
          <text class="sum-label">陪诊人</text>
          <text class="sum-value">{{companionName}}</text>
        </view>
        <view class="sum-row">
          <text class="sum-label">联系人</text>
          <text class="sum-value">{{form.contactName}} {{form.phone}}</text>
        </view>
        <view class="sum-row">
          <text class="sum-label">地址</text>
          <text class="sum-value">{{form.address}}</text>
        </view>
        <view class="sum-row" wx:if="{{form.remark}}">
          <text class="sum-label">备注</text>
          <text class="sum-value">{{form.remark}}</text>
        </view>
      </view>

      <view class="notice">
        <text class="notice-text">提交后服务人员会在 30 分钟内电话确认，请保持手机畅通。</text>
      </view>
    </block>

  </view>

  <!-- 底部按钮 -->
  <view class="footer">
    <button class="btn btn-ghost footer-back" wx:if="{{step > 1}}" bindtap="prevStep">上一步</button>
    <button class="btn btn-primary footer-next" bindtap="nextStep">{{step === 3 ? '提交预约' : '下一步'}}</button>
  </view>

</view>
