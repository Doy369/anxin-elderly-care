<view class="page {{bigFont ? 'bigfont' : ''}}">

  <!-- 服务概要 -->
  <view class="svc-summary">
    <text class="ss-icon">{{service.icon}}</text>
    <view class="ss-body">
      <text class="ss-name">{{service.name}}</text>
      <text class="ss-provider">{{service.provider}}</text>
      <view class="ss-meta">
        <text class="ss-meta-item">⭐ {{service.rating}}</text>
        <text class="ss-meta-item">{{service.duration}}</text>
        <text class="ss-meta-item">{{service.orderCountText}} 单</text>
      </view>
    </view>
    <view class="ss-price">
      <text class="price"><text class="price-symbol">¥</text><text class="price-num">{{service.price}}</text></text>
      <text class="price-unit">{{service.priceUnit}}{{service.unit}}</text>
    </view>
  </view>

  <view class="pad">

    <!-- 服务内容 -->
    <view class="card">
      <view class="card-title">服务包含</view>
      <view class="inc-row" wx:for="{{service.includes}}" wx:key="*this">
        <text class="inc-dot">✓</text>
        <text class="inc-text">{{item}}</text>
      </view>
    </view>

    <!-- 服务流程 -->
    <view class="card">
      <view class="card-title">服务流程</view>
      <view class="step-row" wx:for="{{service.process}}" wx:key="*this">
        <view class="step-no">{{index + 1}}</view>
        <text class="step-text">{{item}}</text>
      </view>
    </view>

    <view class="detail-anchor" id="detail"></view>

    <!-- 预约表单 -->
    <view class="card form-card">
      <view class="card-title">填写预约信息</view>

      <!-- 服务对象 -->
      <view class="form-item">
        <text class="form-label">服务对象<text class="required">*</text></text>
        <view class="mode-hint" wx:if="{{mode === 'family'}}">
          <text class="mode-hint-text">当前为「帮家人下单」模式，服务记录会同步给家人</text>
        </view>
        <view class="who-row">
          <view class="who-chip {{form.forWhom === '本人' ? 'active' : ''}}" data-name="本人" bindtap="pickWho">
            <text class="who-text">{{mode === 'family' ? '我本人' : '我自己'}}</text>
          </view>
          <view class="who-chip" wx:for="{{members}}" wx:key="id" data-name="{{item.name}}" data-id="{{item.id}}" bindtap="pickWho">
            <text class="who-text">{{item.relation}}·{{item.name}}</text>
          </view>
          <view class="who-chip add" bindtap="goFamily">
            <text class="who-add">+ 添加家人</text>
          </view>
        </view>
      </view>

      <!-- 联系人 -->
      <view class="form-item">
        <text class="form-label">联系人姓名<text class="required">*</text></text>
        <input class="input" placeholder="请输入姓名" value="{{form.contactName}}" data-field="contactName" bindinput="onInput" />
      </view>

      <view class="form-item">
        <text class="form-label">联系电话<text class="required">*</text></text>
        <input class="input" type="number" maxlength="11" placeholder="请输入11位手机号" value="{{form.phone}}" data-field="phone" bindinput="onInput" />
      </view>

      <!-- 上门地址 -->
      <view class="form-item">
        <text class="form-label">上门地址<text class="required">*</text></text>
        <view class="addr-box">
          <input class="input" placeholder="请填写详细地址，如 XX小区3栋201" value="{{form.address}}" data-field="address" bindinput="onInput" />
          <button class="btn btn-ghost btn-sm addr-locate" bindtap="useCurrentLocation">📍 当前定位</button>
        </view>
        <text class="field-tip" wx:if="{{locating}}">正在获取位置…</text>
        <text class="field-tip" wx:if="{{form.address}}">{{form.address}}</text>
      </view>

      <!-- 上门时间 -->
      <view class="form-item">
        <text class="form-label">上门日期<text class="required">*</text></text>
        <picker mode="date" value="{{form.date}}" start="{{today}}" bindchange="onDateChange">
          <view class="picker-box {{form.date ? '' : 'placeholder'}}">
            <text>{{form.date || '请选择日期'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">上门时段<text class="required">*</text></text>
        <view class="slot-grid">
          <view class="slot-item {{form.timeSlot === item ? 'active' : ''}}" wx:for="{{timeSlots}}" wx:key="*this" data-slot="{{item}}" bindtap="pickSlot">
            <text class="slot-text">{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 服务数量 -->
      <view class="form-item">
        <text class="form-label">{{quantityLabel}}</text>
        <view class="qty-row">
          <view class="qty-btn" bindtap="minusQty">−</view>
          <text class="qty-num">{{form.quantity}}</text>
          <view class="qty-btn" bindtap="plusQty">+</view>
          <text class="qty-hint">{{quantityHint}}</text>
        </view>
      </view>

      <!-- 备注 -->
      <view class="form-item">
        <text class="form-label">补充说明</text>
        <textarea class="textarea" placeholder="例如：家里有台阶需要搭梯子、老人对某些食物忌口、需要家属陪同等" value="{{form.remark}}" data-field="remark" bindinput="onInput" />
      </view>

      <!-- 联系人同步 -->
      <view class="form-item">
        <text class="form-label">服务情况通知给</text>
        <view class="notify-tip">
          <text class="notify-text">服务人员的联系电话与服务记录会通过这里预留的号码发送</text>
        </view>
        <input class="input" placeholder="选填：家属手机号" value="{{form.familyPhone}}" data-field="familyPhone" bindinput="onInput" />
      </view>
    </view>

    <!-- 费用预估 -->
    <view class="card">
      <view class="card-title">费用预估</view>
      <view class="fee-row">
        <text class="fee-label">{{service.name}} × {{form.quantity}}</text>
        <text class="fee-value">¥{{estimate}}</text>
      </view>
      <view class="fee-tip">实际费用以师傅上门测量后的最终报价为准，改造类项目会提前电话确认</view>
    </view>

    <view class="safe-tip">
      <text class="safe-icon">🛡</text>
      <text class="safe-text">平台全程保障 · 人员实名认证 · 不满意 24 小时内可退</text>
    </view>
  </view>

  <!-- 底部提交栏 -->
  <view class="footer">
    <view class="footer-price">
      <text class="fp-label">预估</text>
      <text class="price"><text class="price-symbol">¥</text><text class="price-num">{{estimate}}</text></text>
    </view>
    <button class="btn btn-accent btn-lg footer-btn" bindtap="submit">立即预约</button>
  </view>

</view>
