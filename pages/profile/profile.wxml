<view class="page {{bigFont ? 'bigfont' : ''}}">

  <view class="head-card" bindtap="editProfile">
    <view class="avatar">
      <text class="avatar-emoji">{{avatarEmoji}}</text>
    </view>
    <view class="head-body">
      <text class="head-name">{{name}}</text>
      <text class="head-meta">{{meta}}</text>
    </view>
    <text class="head-arrow">›</text>
  </view>

  <view class="pad">
    <view class="group">
      <view class="row-item" bindtap="goFamily">
        <text class="row-icon">👨‍👩‍👧</text>
        <view class="row-body">
          <text class="row-name">家人绑定</text>
          <text class="row-desc">让爱常伴左右</text>
        </view>
        <text class="row-arrow">›</text>
      </view>

      <view class="row-item" bindtap="goMyHome">
        <text class="row-icon">🏠</text>
        <view class="row-body">
          <text class="row-name">我的房屋</text>
          <text class="row-desc">房屋信息与评估记录</text>
        </view>
        <text class="row-arrow">›</text>
      </view>

      <view class="row-item" bindtap="goOrders">
        <text class="row-icon">📋</text>
        <view class="row-body">
          <text class="row-name">我的订单</text>
          <text class="row-desc">服务订单与进度</text>
        </view>
        <text class="row-arrow">›</text>
      </view>

      <view class="row-item" bindtap="goFavorites">
        <text class="row-icon">⭐</text>
        <view class="row-body">
          <text class="row-name">我的收藏</text>
          <text class="row-desc">我喜欢的服务与内容</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
    </view>

    <view class="group">
      <view class="row-item">
        <text class="row-icon">⚙️</text>
        <view class="row-body">
          <text class="row-name">适老化设置</text>
          <text class="row-desc">大字体 · 语音助手 · 简洁模式</text>
        </view>
        <view class="switch {{bigFont ? 'on' : ''}}" catchtap="toggleBigFont">
          <view class="switch-dot"></view>
        </view>
      </view>

      <view class="row-item" bindtap="callService">
        <text class="row-icon">📞</text>
        <view class="row-body">
          <text class="row-name">联系客服</text>
          <text class="row-desc">400-800-1234 · 8:00-20:00</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
    </view>

    <view class="group">
      <view class="row-item" bindtap="goStaff">
        <text class="row-icon">🛠️</text>
        <view class="row-body">
          <text class="row-name">服务人员入口</text>
          <text class="row-desc">师傅接单、打卡、上传服务记录</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
    </view>

    <view class="promo">
      <view class="promo-body">
        <text class="promo-title">让家更适老</text>
        <text class="promo-sub">让生活更美好</text>
      </view>
      <text class="promo-emoji">🏡</text>
    </view>

    <text class="version">安心养老 · v1.0.0</text>
  </view>

</view>
