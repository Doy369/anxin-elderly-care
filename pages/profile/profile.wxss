/* 我的 */
.head-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  margin: 24rpx 32rpx 8rpx;
  padding: 32rpx 28rpx;
  border-radius: 32rpx;
  box-shadow: 0 6rpx 22rpx rgba(58, 92, 64, 0.06);
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #EAF6EB;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 26rpx;
  flex-shrink: 0;
}

.avatar-emoji {
  font-size: 68rpx;
}

.head-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.head-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2D22;
}

.head-meta {
  font-size: 25rpx;
  color: #5F7165;
  margin-top: 10rpx;
}

.head-arrow {
  font-size: 38rpx;
  color: #7A8C7E;
}

/* 分组卡片 */
.group {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 0 28rpx;
  margin-top: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(58, 92, 64, 0.05);
}

/* 推广卡 */
.promo {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #EAF6EB 0%, #DCEFDE 100%);
  border-radius: 32rpx;
  padding: 34rpx 30rpx;
  display: flex;
  align-items: center;
}

.promo-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.promo-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2E7D32;
}

.promo-sub {
  font-size: 26rpx;
  color: #5C8A61;
  margin-top: 8rpx;
}

.promo-emoji {
  font-size: 88rpx;
}

.version {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #7A8C7E;
  margin-top: 40rpx;
}

/* ===== 超大字体（适老化）覆盖样式 ===== */
.bigfont .head-name {
  font-size: 49rpx;
  font-weight: 700;
  color: #1F2D22;
}

.bigfont .head-meta {
  font-size: 30rpx;
  color: #5F7165;
  margin-top: 11rpx;
}

.bigfont .promo-title {
  font-size: 41rpx;
  font-weight: 700;
  color: #2E7D32;
}

.bigfont .promo-sub {
  font-size: 31rpx;
  color: #5C8A61;
  margin-top: 9rpx;
}
