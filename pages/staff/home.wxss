/* 师傅端 · 工单列表 */
.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 28rpx;
  padding-bottom: 24rpx;
}

.top-left {
  display: flex;
  flex-direction: column;
}

.top-title {
  font-size: 46rpx;
  font-weight: 700;
  color: #1F2D22;
  letter-spacing: 1rpx;
}

.top-sub {
  font-size: 25rpx;
  color: #5F7165;
  margin-top: 10rpx;
}

/* 未认证 */
.auth-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(58, 92, 64, 0.05);
}

.auth-emoji {
  font-size: 84rpx;
  margin-bottom: 20rpx;
}

.auth-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2D22;
}

.auth-desc {
  font-size: 26rpx;
  color: #5F7165;
  margin-top: 14rpx;
  line-height: 1.7;
}

.auth-btn {
  margin-top: 36rpx;
}

/* 分段 */
.seg {
  display: flex;
  background: #E9F1E9;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.seg-item {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #5F7165;
}

.seg-item.on {
  background: #FFFFFF;
  color: #2E7D32;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(58, 92, 64, 0.08);
}

.seg-num {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #2E7D32;
}

/* 工单卡 */
.w-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(58, 92, 64, 0.05);
}

.wc-top {
  display: flex;
  align-items: center;
}

.wc-emoji {
  font-size: 44rpx;
  margin-right: 18rpx;
}

.wc-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.wc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2D22;
}

.wc-time {
  font-size: 24rpx;
  color: #5F7165;
  margin-top: 6rpx;
}

.wc-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: #C4512E;
  flex-shrink: 0;
}

.wc-status {
  font-size: 23rpx;
  color: #2E7D32;
  background: #EAF6EB;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.wc-addr {
  font-size: 25rpx;
  color: #3D4A3F;
  margin-top: 18rpx;
  line-height: 1.5;
}

.wc-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.wc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #F1F6F1;
}

.wc-hint {
  flex: 1;
  font-size: 23rpx;
  color: #5F7165;
}

.wc-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.wc-more {
  font-size: 25rpx;
  color: #2E7D32;
}

/* ===== 超大字体（适老化）覆盖样式 ===== */
.bigfont .top-title {
  font-size: 57rpx;
  font-weight: 700;
  color: #1F2D22;
}

.bigfont .top-sub {
  font-size: 31rpx;
  color: #5F7165;
  margin-top: 12rpx;
}

.bigfont .wc-name {
  font-size: 39rpx;
  font-weight: 700;
  color: #1F2D22;
}

.bigfont .wc-time {
  font-size: 30rpx;
  color: #5F7165;
  margin-top: 7rpx;
}

.bigfont .wc-addr {
  font-size: 31rpx;
  color: #3D4A3F;
  margin-top: 22rpx;
  line-height: 1.5;
}

.bigfont .wc-hint {
  font-size: 28rpx;
  color: #5F7165;
}

.empty-sub {
  display: block;
  font-size: 24rpx;
  color: #5F7165;
  margin-top: 8rpx;
}
