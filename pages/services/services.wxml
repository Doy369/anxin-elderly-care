<view class="page {{bigFont ? 'bigfont' : ''}}">

  <!-- 搜索 -->
  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索服务，如：扶手、防滑、护理" placeholder-class="search-ph" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="clearSearch">✕</text>
    </view>
  </view>

  <!-- 分类 -->
  <view class="cat-bar">
    <scroll-view class="cat-scroll" scroll-x="true" show-scrollbar="{{false}}">
      <view class="cat-row">
        <view class="cat-item {{activeCat === item.id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="switchCat">
          <text class="cat-icon">{{item.icon}}</text>
          <text class="cat-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="pad">
    <view class="result-count">共 {{list.length}} 项服务</view>

    <view wx:if="{{list.length === 0}}" class="empty">
      <text class="empty-icon">🔍</text>
      <text class="empty-text">没有找到相关服务，换个词试试</text>
    </view>

    <view class="card svc-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goBooking">
      <view class="svc-top">
        <text class="svc-icon">{{item.icon}}</text>
        <view class="svc-body">
          <text class="svc-name">{{item.name}}</text>
          <view class="svc-meta">
            <text class="svc-meta-item">⭐ {{item.rating}}</text>
            <text class="svc-meta-item">{{item.duration}}</text>
            <text class="svc-meta-item">{{item.orderCountText}} 单</text>
          </view>
        </view>
        <view class="svc-price">
          <text class="price"><text class="price-symbol">¥</text><text class="price-num">{{item.price}}</text></text>
          <text class="price-unit">{{item.priceUnit}}{{item.unit}}</text>
        </view>
      </view>

      <view class="svc-provider">🏷 {{item.provider}}</view>
      <view class="svc-desc">{{item.desc}}</view>

      <view class="tag-row">
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
      </view>

      <view class="svc-foot">
        <text class="svc-detail-link" catchtap="goDetail" data-id="{{item.id}}">看服务详情 ›</text>
        <button class="btn btn-primary btn-sm" catchtap="goBooking" data-id="{{item.id}}">立即预约</button>
      </view>
    </view>
  </view>

</view>
