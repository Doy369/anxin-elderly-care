page {
  background: #FFFFFF;}

.page {
  padding-bottom: 60rpx;}

.pad {
  padding: 0 30rpx;}


/* 搜索 */
.search-bar {
  padding: 24rpx 30rpx;
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 10;}

.search-box {
  height: 92rpx;
  background: #F4F8F5;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;}

.search-icon {
  font-size: 30rpx;
  margin-right: 14rpx;}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: #14261F;}

.search-ph {
  color: #9AA8A2;
  font-size: 28rpx;}

.search-clear {
  font-size: 28rpx;
  color: #9AA8A2;
  padding: 0 8rpx;}


/* 分类 */
.cat-bar {
  background: #FFFFFF;
  padding-bottom: 20rpx;}

.cat-scroll {
  white-space: nowrap;}

.cat-row {
  display: inline-flex;
  padding: 12rpx 30rpx 0;}

.cat-item {
  display: inline-flex;
  align-items: center;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #F4F8F5;
  margin-right: 20rpx;}

.cat-item.active {
  background: #15803D;}

.cat-icon {
  font-size: 28rpx;
  margin-right: 10rpx;}

.cat-name {
  font-size: 28rpx;
  color: #55665E;
  font-weight: 600;}

.cat-item.active .cat-name {
  color: #FFFFFF;}

.result-count {
  font-size: 26rpx;
  color: #7A8B85;
  margin: 28rpx 0 20rpx;}


/* 卡片 */
.svc-card {
  border: 2rpx solid #E6EFE9;
  padding: 30rpx;}

.svc-top {
  display: flex;
  align-items: flex-start;}

.svc-icon {
  font-size: 48rpx;
  margin-right: 20rpx;}

.svc-body {
  flex: 1;
  display: flex;
  flex-direction: column;}

.svc-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #14261F;}

.svc-meta {
  display: flex;
  margin-top: 10rpx;
  flex-wrap: wrap;}

.svc-meta-item {
  font-size: 25rpx;
  color: #7A8B85;
  margin-right: 24rpx;}

.svc-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;}

.price {
  color: #0F7A38;
  font-weight: 700;
  display: flex;
  align-items: baseline;}

.price-symbol {
  font-size: 26rpx;}

.price-num {
  font-size: 44rpx;}

.price-unit {
  font-size: 24rpx;
  color: #7A8B85;
  margin-top: 2rpx;}

.svc-provider {
  font-size: 25rpx;
  color: #15803D;
  margin-top: 16rpx;}

.svc-desc {
  font-size: 28rpx;
  color: #55665E;
  margin-top: 12rpx;
  line-height: 1.65;}

.tag-row {
  margin-top: 18rpx;}

.tag {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #E9F6EE;
  color: #15803D;
  margin-right: 12rpx;
  margin-bottom: 8rpx;}

.svc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;}

.svc-detail-link {
  font-size: 28rpx;
  color: #7A8B85;}

.btn-sm {
  height: 80rpx;
  font-size: 30rpx;
  border-radius: 16rpx;
  padding: 0 40rpx;
  background: #15803D;
  color: #FFFFFF;
  font-weight: 700;}

.btn-sm::after {
  border: none;}


/* 空状态 */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;}

.empty-icon {
  font-size: 96rpx;}

.empty-text {
  font-size: 30rpx;
  color: #7A8B85;
  margin-top: 24rpx;
  display: block;}


