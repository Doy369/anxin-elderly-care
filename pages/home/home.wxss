/* 首页 */
.hero {
  padding-top: 36rpx;
  padding-bottom: 32rpx;
  display: flex;
  flex-direction: column;
}

.hi {
  font-size: 46rpx;
  font-weight: 700;
  color: #1F2D22;
  letter-spacing: 1rpx;
}

.hi-sub {
  font-size: 25rpx;
  color: #5F7165;
  margin-top: 12rpx;
}

/* 主行动卡 */
.action-card {
  background: linear-gradient(135deg, #3D9142 0%, #2E7D32 100%);
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 12rpx 30rpx rgba(67, 160, 71, 0.22);
}

.ac-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ac-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.ac-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 10rpx;
}

.ac-btn {
  align-self: flex-start;
  margin-top: 22rpx;
  height: 64rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
  color: #FFFFFF;
  font-size: 25rpx;
  display: flex;
  align-items: center;
}

.ac-emoji {
  font-size: 100rpx;
  margin-left: 16rpx;
}

/* 快捷入口 */
.quick {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
}

.quick-item {
  width: 31.5%;
  background: #FFFFFF;
  border-radius: 26rpx;
  padding: 26rpx 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(58, 92, 64, 0.05);
}

.quick-emoji {
  font-size: 48rpx;
}

.quick-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #1F2D22;
  margin-top: 14rpx;
}

.quick-desc {
  font-size: 20rpx;
  color: #5F7165;
  margin-top: 6rpx;
  text-align: center;
}

/* 订单卡 */
.order-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(58, 92, 64, 0.05);
}

.oc-top {
  display: flex;
  align-items: center;
}

.oc-emoji {
  font-size: 44rpx;
  margin-right: 18rpx;
}

.oc-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.oc-name {
  font-size: 31rpx;
  font-weight: 700;
  color: #1F2D22;
}

.oc-time {
  font-size: 24rpx;
  color: #5F7165;
  margin-top: 6rpx;
}

.oc-status {
  font-size: 23rpx;
  color: #2E7D32;
  background: #EAF6EB;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.oc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #F1F6F1;
}

.oc-addr {
  flex: 1;
  font-size: 24rpx;
  color: #5F7165;
}

.oc-more {
  font-size: 25rpx;
  color: #2E7D32;
}

/* 提示卡 */
.tip-card {
  display: flex;
  align-items: flex-start;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(58, 92, 64, 0.05);
}

.tip-emoji {
  font-size: 46rpx;
  margin-right: 20rpx;
}

.tip-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tip-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #1F2D22;
  line-height: 1.5;
}

.tip-desc {
  font-size: 24rpx;
  color: #5F7165;
  margin-top: 8rpx;
  line-height: 1.6;
}

/* ===== 超大字体（适老化）覆盖样式 ===== */
.bigfont .hi {
  font-size: 57rpx;
  font-weight: 700;
  color: #1F2D22;
  letter-spacing: 1rpx;
}

.bigfont .hi-sub {
  font-size: 31rpx;
  color: #5F7165;
  margin-top: 14rpx;
}

.bigfont .ac-title {
  font-size: 47rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.bigfont .ac-sub {
  font-size: 31rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 11rpx;
}

.bigfont .quick-name {
  font-size: 33rpx;
  font-weight: 600;
  color: #1F2D22;
  margin-top: 16rpx;
}

.bigfont .quick-desc {
  font-size: 24rpx;
  color: #5F7165;
  margin-top: 7rpx;
  text-align: center;
}

.bigfont .oc-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #1F2D22;
}

.bigfont .tip-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2D22;
  line-height: 1.5;
}

.bigfont .tip-desc {
  font-size: 30rpx;
  color: #5F7165;
  margin-top: 9rpx;
  line-height: 1.6;
}
