page {
  background: #F4F8F2;
}

.page {
  padding-bottom: 60rpx;}

.pad {
  padding: 0 30rpx;}

.status-hero {
  padding: 44rpx 30rpx 48rpx;
  display: flex;
  flex-direction: column;}

.hero-serving {
  background: linear-gradient(150deg, #2E7D32, #43A047);}

.hero-canceled {
  background: linear-gradient(150deg, #8C9A93, #B4C0BA);}

.sh-status {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;}

.sh-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 12rpx;}

.card {
  border: 2rpx solid #EDF3ED;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 24rpx;}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2D22;
  margin-bottom: 26rpx;}


/* 时间线 */
.tl-row {
  display: flex;}

.tl-left {
  width: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;}

.tl-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #DFE8E2;
  margin-top: 12rpx;}

.tl-dot.done {
  background: #2E7D32;}

.tl-dot.current {
  background: #2E7D32; border: 6rpx solid #BFE6CC; width: 38rpx; height: 38rpx; margin-top: 6rpx;}

.tl-line {
  flex: 1;
  width: 3rpx;
  background: #DFE8E2;
  margin: 8rpx 0;
  min-height: 40rpx;}

.tl-body {
  flex: 1;
  padding-bottom: 36rpx;}

.tl-title {
  font-size: 29rpx;
  color: #5F7165;}

.tl-title.active {
  color: #1F2D22;
  font-weight: 700;}

.tl-time {
  display: block;
  font-size: 24rpx;
  color: #5F7165;
  margin-top: 8rpx;}


/* 信息 */
.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;}

.info-label {
  font-size: 27rpx;
  color: #5F7165;
  width: 170rpx;
  flex-shrink: 0;}

.info-value {
  flex: 1;
  font-size: 29rpx;
  color: #3D4A3F;
  line-height: 1.6;}

.info-value.amount {
  color: #C4512E;
  font-weight: 700;}

.info-value.muted {
  color: #5F7165;
  font-size: 26rpx;}


/* 记录 */
.rec-empty {
  background: #F6FAF5;
  border-radius: 16rpx;
  padding: 26rpx 24rpx;}

.rec-empty-text {
  font-size: 26rpx;
  color: #5F7165;
  line-height: 1.6;}

.rec-item {
  border-left: 4rpx solid #2E7D32;
  padding: 6rpx 0 6rpx 22rpx;
  margin-bottom: 26rpx;}

.rec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;}

.rec-time {
  font-size: 24rpx;
  color: #5F7165;}

.rec-who {
  font-size: 24rpx;
  color: #2E7D32;
  font-weight: 600;}

.rec-content {
  font-size: 28rpx;
  color: #3D4A3F;
  line-height: 1.65;}

.rec-demo-btn {
  margin-top: 8rpx;
  height: 88rpx;
  font-size: 27rpx;}


/* 危险区 */
.danger-card {
  border: 2rpx solid #E8F0E9;}

.danger-tip {
  display: block;
  font-size: 25rpx;
  color: #6B7C74;
  margin-bottom: 24rpx;
  line-height: 1.6;}

.foot-actions {
  margin-top: 36rpx;}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  padding: 0 40rpx;}

.btn::after {
  border: none;}

.btn-block {
  width: 100%;}

.btn-ghost {
  background: #FFFFFF;
  color: #2E7D32;
  border: 2rpx solid #2E7D32;}

.danger-card .btn-ghost {
  color: #6B7B6E;
  border-color: #6B7B6E;}


